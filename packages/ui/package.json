{
  "name": "@occ/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Svelte UI of the OpenCode clients. Talks to its host only through the HostBridge interface (src/bridge.ts).",
  "exports": {
    "./*.svelte": "./src/*.svelte",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@occ/core": "workspace:*",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
