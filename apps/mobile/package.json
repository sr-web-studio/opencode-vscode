{
  "name": "@occ/mobile",
  "version": "0.2.3-beta",
  "private": true,
  "type": "module",
  "description": "OpenCode (unofficial) for Android: a Capacitor shell around @occ/ui. The controller runs inside the app and talks to the OpenCode server over HTTP.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "android:sync": "vite build && cap sync android",
    "apk": "bun run android:sync && cd android && ./gradlew assembleDebug",
    "apk:test": "bun run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@occ/core": "workspace:*",
    "@occ/ui": "workspace:*",
    "@opencode/client": "2.2.5",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@vscode/codicons": "^0.0.46-24",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  }
}
