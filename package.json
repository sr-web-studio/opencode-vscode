{
  "name": "opencode-workspace",
  "private": true,
  "description": "Bun workspace for the OpenCode (unofficial) clients: packages/core, packages/ui, apps/vscode, apps/mobile. See docs/monorepo.md.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/vscode build",
    "watch": "bun run --cwd apps/vscode watch",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/ui typecheck && bun run --cwd apps/vscode typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd plugins/opencode-push typecheck",
    "mobile:build": "bun run --cwd apps/mobile build",
    "mobile:apk": "bun run --cwd apps/mobile apk",
    "test": "bun test test/unit",
    "test:plugin": "bun run --cwd plugins/opencode-push test",
    "test:host": "bun run --cwd apps/vscode test:host",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "bun run --cwd apps/vscode package",
    "sanitize-fixtures": "bun scripts/sanitize-fixtures.ts",
    "publish:marketplace": "bun run --cwd apps/vscode publish:marketplace",
    "publish:openvsx": "bun run --cwd apps/vscode publish:openvsx"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4"
  }
}
