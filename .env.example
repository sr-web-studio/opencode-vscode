# Local secrets only. Copy to `.env` (git-ignored, excluded from the vsix). Never commit real tokens.

# VS Code Marketplace: Azure DevOps PAT, scope Marketplace → Manage, organization = All accessible organizations.
# The Microsoft identity behind the PAT must be an Owner of the Marketplace publisher `sr-web-studio`.
VSCE_PAT=

# Open VSX: personal access token from https://open-vsx.org/user-settings/tokens (namespace `sr-web-studio`).
OVSX_PAT=

# Voice input during development only. The shipped extension reads the user's key from SecretStorage.
SONIOX_API_KEY=
