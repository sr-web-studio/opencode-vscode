{
  "name": "opencode-voice",
  "displayName": "OpenCode Voice (unofficial)",
  "description": "Voice input for the OpenCode (unofficial) extension: records your microphone on this computer and types what you say (Bangla, English and more) into the prompt box. Bring your own Soniox key. Unofficial — not affiliated with the OpenCode team.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "preview": true,
  "keywords": [
    "opencode",
    "voice",
    "dictation",
    "speech to text",
    "bangla"
  ],
  "homepage": "https://github.com/sr-web-studio/opencode-vscode#readme",
  "bugs": {
    "url": "https://github.com/sr-web-studio/opencode-vscode/issues"
  },
  "version": "0.3.5",
  "publisher": "sr-web-studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sr-web-studio/opencode-vscode.git"
  },
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:opencode.companion.ping",
    "onCommand:opencode.companion.voice.start",
    "onCommand:opencode.companion.voice.stop",
    "onCommand:opencode.companion.voice.chooseMicrophone",
    "onCommand:opencode.companion.voice.micSettings"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencode.companion.voice.chooseMicrophone",
        "title": "Choose Microphone",
        "category": "OpenCode Voice"
      },
      {
        "command": "opencode.companion.voice.micSettings",
        "title": "Open Microphone Settings",
        "category": "OpenCode Voice"
      }
    ]
  }
}
